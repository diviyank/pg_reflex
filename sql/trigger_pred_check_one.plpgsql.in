IF _rec.where_predicate IS NOT NULL THEN
               EXECUTE format('SELECT EXISTS(SELECT 1 FROM %I WHERE %s LIMIT 1)', '__REFLEX_SLOT_TRANSITION_TBL__', _rec.where_predicate) INTO _pred_match;
               IF NOT _pred_match AND __REFLEX_SLOT_MAY_SKIP__ THEN __REFLEX_SLOT_SKIPPED__ CONTINUE; END IF;
             END IF;

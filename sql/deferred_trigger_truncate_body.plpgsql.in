DECLARE _rec RECORD; _stmts TEXT; _state TEXT; _announced TEXT[]; _rebuilt BOOLEAN; _was_announced BOOLEAN;
BEGIN
    -- A TRUNCATE fires this function before and after for every relation it
    -- truncates (a partition, or the source and each of its partitions), all the
    -- BEFORE firings first. They announce the relations of the statement; the
    -- first AFTER firing rebuilds the IMVs and those of the other announced
    -- relations do nothing. An AFTER firing of a relation nothing announced
    -- rebuilds: a relation can lack either trigger, and its statement is then
    -- indistinguishable from a new one.
    _state := COALESCE(current_setting('__REFLEX_SLOT_ANNOUNCED_SETTING__', true), '');
    _rebuilt := _state LIKE 'rebuilt:%';
    _announced := string_to_array(NULLIF(split_part(_state, ':', 2), ''), ',');
    IF TG_WHEN = 'BEFORE' THEN
        IF _rebuilt THEN _announced := NULL; END IF;
        PERFORM set_config('__REFLEX_SLOT_ANNOUNCED_SETTING__',
            'announced:' || array_to_string(array_append(_announced, TG_RELID::TEXT), ','), true);
        RETURN NULL;
    END IF;
    _was_announced := COALESCE(TG_RELID::TEXT = ANY(_announced), FALSE);
    PERFORM set_config('__REFLEX_SLOT_ANNOUNCED_SETTING__',
        'rebuilt:' || COALESCE(array_to_string(array_remove(_announced, TG_RELID::TEXT), ','), ''), true);
    IF _rebuilt AND _was_announced THEN RETURN NULL; END IF;
    -- The rebuild reflects every partition the source has now: a partition added
    -- or removed in this transaction must not be applied again by the flush.
    PERFORM set_config('__REFLEX_SLOT_WRITTEN_SETTING__', '1', true);
    FOR _rec IN
      SELECT name, ignored_sources
      FROM public.__reflex_ivm_reference
      WHERE '__REFLEX_SLOT_SOURCE_TABLE__' = ANY(depends_on) AND enabled = TRUE
      ORDER BY graph_depth, name
    LOOP
      IF _rec.ignored_sources IS NOT NULL AND ('__REFLEX_SLOT_SOURCE_TABLE__' = ANY(_rec.ignored_sources) OR '__REFLEX_SLOT_BARE_SOURCE__' = ANY(_rec.ignored_sources)) THEN CONTINUE; END IF;
      PERFORM pg_advisory_xact_lock(hashtext(_rec.name), hashtext(reverse(_rec.name)));
      _stmts := public.reflex_build_truncate_sql(_rec.name);
      IF _stmts <> '' THEN PERFORM public.reflex_execute_separated(_stmts); END IF;
    END LOOP;
    TRUNCATE __REFLEX_SLOT_DELTA_TBL__;
    DELETE FROM public.__reflex_deferred_pending WHERE source_table = '__REFLEX_SLOT_SOURCE_TABLE__' AND operation <> 'TRUNCATE';
    RETURN NULL;
END;

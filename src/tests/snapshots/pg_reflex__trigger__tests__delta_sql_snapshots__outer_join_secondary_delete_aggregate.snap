TRUNCATE "__reflex_affected_v"
--<<REFLEX_SEP>>--
INSERT INTO "__reflex_affected_v" SELECT DISTINCT "region" FROM (SELECT o.region, SUM(o.qty) AS qty FROM orders o LEFT JOIN "__reflex_old_customers" c ON c.id = o.customer_id GROUP BY o.region) AS __d
